/*
 * Sofle RGB ZMK keymap
 * Converted from QMK keymap.c
 *
 * Layout: Layer 0 = DVORAK (元QMKのlayer 0)
 * Layer 1 (lower): Fn / Symbols / Numpad
 * Layer 2 (raise): Mouse / Navigation
 *
 * Notes:
 *  - RGB underglow は無効（OLEDのみ有効）
 *  - DF(0)/DF(1) はLayer 0 (DVORAK) に固定
 *  - KC_INT4 → INT4, KC_INT5 → INT5
 *  - QK_BOOTLOADER → &bootloader
 *  - KC_MPLY / KC_MEDIA_PLAY_PAUSE → &kp C_PP
 *  - KC_MEDIA_SELECT → &kp C_MENU
 *  - NK_ON → ZMKではN-Key Rolloverがデフォルトのため &trans に
 *  - MS_* マウスキーは &mmv / &msc / &mkp に変換
 *  - MS_ACL0/1/2 はZMKに対応なし → &trans (要カスタム対応)
 *  - エンコーダー動作は sofle.conf + behaviors で設定
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>

/* マウス移動・スクロール量の調整 */
#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1500
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20

/ {
    /* ------------------------------------------------------------------ */
    /*  エンコーダー動作定義                                               */
    /*  左: Layer0=MB4/MB5(マウスボタン), 他=WHEEL_LEFT/RIGHT             */
    /*  右: Layer0=WHEEL_UP/DOWN,         他=PGUP/PGDN                    */
    /* ------------------------------------------------------------------ */
    behaviors {
        /* 左エンコーダー: Layer0 ではマウスボタン4/5、それ以外はホイール横 */
        left_enc: left_encoder {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <20>;
    };

    /* ------------------------------------------------------------------ */
    /*  キーマップ                                                          */
    /* ------------------------------------------------------------------ */
    keymap {
        compatible = "zmk,keymap";

        /* ============================================================== */
        /* Layer 0: DVORAK (QMK layer 0)                                  */
        /* ============================================================== */
        default_layer {
            label = "DVORAK";
            /*
             * ┌──────┬─────┬─────┬─────┬─────┬─────┐                  ┌─────┬─────┬─────┬─────┬─────┬──────┐
             * │ ESC  │  1  │  2  │  3  │  4  │  5  │                  │  6  │  7  │  8  │  9  │  0  │  `   │
             * ├──────┼─────┼─────┼─────┼─────┼─────┤                  ├─────┼─────┼─────┼─────┼─────┼──────┤
             * │ TAB  │  Q  │  O  │  U  │  ,  │  .  │                  │  C  │  W  │  R  │  J  │  F  │  '   │
             * ├──────┼─────┼─────┼─────┼─────┼─────┤                  ├─────┼─────┼─────┼─────┼─────┼──────┤
             * │LT2BS │  X  │  I  │  E  │  A  │  -  │                  │  K  │  T  │  N  │  S  │  P  │ENTER │
             * ├──────┼─────┼─────┼─────┼─────┼─────┼──────┐  ┌───────┼─────┼─────┼─────┼─────┼─────┼──────┤
             * │LSHFT │  H  │  L  │  Y  │  V  │  /  │C_PP  │  │C_PP   │  G  │  D  │  M  │  Z  │  B  │RSHFT │
             * └──────┴─────┴─────┼─────┼─────┼─────┼──────┘  └───────┼─────┼─────┼─────┴─────┴─────┴──────┘
             *                    │LCTL │LALT │LGUI │ SPC  │  │BSPC   │LT2  │LT3  │RCTL │
             *                    │     │     │     │      │  │       │INT5 │INT4 │     │  (RALT RGUI 省略=trans)
             *                    └─────┴─────┴─────┴──────┘  └───────┴─────┴─────┴─────┘
             */
            bindings = <
                &kp ESC       &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                            &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp GRAVE
                &kp TAB       &kp Q     &kp O     &kp U     &kp COMMA &kp DOT                           &kp C     &kp W     &kp R     &kp J     &kp F     &kp SQT
                &lt 1 BSPC    &kp X     &kp I     &kp E     &kp A     &kp MINUS                         &kp K     &kp T     &kp N     &kp S     &kp P     &kp ENTER
                &kp LSHFT     &kp H     &kp L     &kp Y     &kp V     &kp SLASH  &kp C_PP    &kp C_PP   &kp G     &kp D     &kp M     &kp Z     &kp B     &kp RSHFT
                                        &kp LCTRL &kp LALT  &kp LGUI  &kp SPACE  &lt 1 INT5  &lt 2 INT4 &kp BSPC  &kp RCTRL &kp RALT  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp MB4 MB5 &inc_dec_kp WHEEL_UP WHEEL_DOWN>;
        };

        /* ============================================================== */
        /* Layer 1: Lower — Fn / Symbols / Numpad (QMK layer 2)           */
        /* ============================================================== */
        lower_layer {
            label = "LOWER";
            /*
             * ┌──────┬─────┬─────┬─────┬─────┬─────┐                  ┌─────┬─────┬─────┬─────┬─────┬──────┐
             * │trans │ F1  │ F2  │ F3  │ F4  │ F5  │                  │ F6  │ F7  │ F8  │ F9  │F10  │ F11  │
             * ├──────┼─────┼─────┼─────┼─────┼─────┤                  ├─────┼─────┼─────┼─────┼─────┼──────┤
             * │  `   │  !  │  @  │  #  │  $  │  %  │                  │ DEL │  7  │  8  │  9  │  =  │ F12  │
             * ├──────┼─────┼─────┼─────┼─────┼─────┤                  ├─────┼─────┼─────┼─────┼─────┼──────┤
             * │trans │  [  │  ]  │  (  │  )  │  {  │                  │  }  │  4  │  5  │  6  │  ;  │  |   │
             * ├──────┼─────┼─────┼─────┼─────┼─────┼──────┐  ┌───────┼─────┼─────┼─────┼─────┼─────┼──────┤
             * │LSHFT │  ^  │  &  │  *  │  +  │  ?  │C_MENU│  │BOOTLDR│  0  │  1  │  2  │  3  │  \  │RSHFT │
             * └──────┴─────┴─────┼─────┼─────┼─────┼──────┘  └───────┼─────┼─────┼─────┴─────┴─────┴──────┘
             *                    │trans│trans│trans│trans │  │ trans  │trans│trans│trans│
             *                    └─────┴─────┴─────┴──────┘  └───────┴─────┴─────┴─────┘
             * ※ DF(1)/DF(0) → 省略（固定レイアウト）
             * ※ KC_NUM → &kp KP_NUM
             */
            bindings = <
                &trans        &kp F1    &kp F2    &kp F3    &kp F4    &kp F5                              &kp F6       &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
                &kp GRAVE     &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT                           &kp DELETE   &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp EQUAL &kp F12
                &trans        &kp LBKT  &kp RBKT  &kp LPAR  &kp RPAR  &kp LBRC                            &kp RBRC     &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp SEMI  &kp PIPE
                &kp LSHFT     &kp CARET &kp AMPS  &kp STAR  &kp PLUS  &kp QMARK  &kp C_MENU  &bootloader  &kp KP_N0   &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp BSLH  &kp RSHFT
                                        &trans    &trans    &trans    &trans     &trans       &trans       &trans      &trans    &trans    &kp KP_NUM
            >;

            sensor-bindings = <&inc_dec_kp WHEEL_LEFT WHEEL_RIGHT &inc_dec_kp PG_UP PG_DN>;
        };

        /* ============================================================== */
        /* Layer 2: Raise — Mouse / Navigation (QMK layer 3)              */
        /* ============================================================== */
        raise_layer {
            label = "RAISE";
            /*
             * ┌──────┬─────┬─────┬─────┬─────┬─────┐                  ┌──────┬──────┬──────┬──────┬──────┬──────┐
             * │trans │     │     │     │     │     │                  │ACL0* │ACL1* │ACL2* │trans │trans │trans │
             * ├──────┼─────┼─────┼─────┼─────┼─────┤                  ├──────┼──────┼──────┼──────┼──────┼──────┤
             * │ ESC  │     │LEFT │ UP  │     │     │                  │SCL_U │MB1   │M_UP  │MB2   │MB5   │      │
             * ├──────┼─────┼─────┼─────┼─────┼─────┤                  ├──────┼──────┼──────┼──────┼──────┼──────┤
             * │ TAB  │     │     │     │RIGHT│     │                  │SCL_D │M_LT  │M_DN  │M_RT  │MB4   │      │
             * ├──────┼─────┼─────┼─────┼─────┼─────┼──────┐  ┌───────┼──────┼──────┼──────┼──────┼──────┼──────┤
             * │LSHFT │     │     │     │     │DOWN │BOOTLDR│  │BOOTLDR│      │SCL_L │MB3   │SCL_R │      │trans │
             * └──────┴─────┴─────┼─────┼─────┼─────┼──────┘  └───────┼──────┼──────┼──────┴──────┴──────┴──────┘
             *                    │LCTL │LALT │LGUI │ SPC  │  │ trans  │trans │trans │      │
             *                    └─────┴─────┴─────┴──────┘  └───────┴──────┴──────┴──────┘
             * ※ MS_ACL0/1/2 はZMK未対応 → &trans に
             * ※ NK_ON → ZMKはデフォルトでNKROのため &trans に
             */
            bindings = <
                &trans        &trans    &trans    &trans    &trans    &trans                              &trans       &trans        &trans       &trans        &trans    &trans
                &kp ESC       &trans    &kp LEFT  &kp UP    &trans    &trans                              &msc SCRL_UP &mkp MB1      &mmv MOVE_UP &mkp MB2      &mkp MB5  &trans
                &kp TAB       &trans    &trans    &trans    &kp RIGHT &trans                              &msc SCRL_DOWN &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &mkp MB4 &trans
                &kp LSHFT     &trans    &trans    &trans    &trans    &kp DOWN   &bootloader  &bootloader &trans       &msc SCRL_LEFT &mkp MB3    &msc SCRL_RIGHT &trans  &trans
                                        &kp LCTRL &kp LALT  &kp LGUI  &kp SPACE  &trans       &trans     &trans       &trans        &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp WHEEL_LEFT WHEEL_RIGHT &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
