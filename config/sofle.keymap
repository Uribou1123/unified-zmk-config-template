/*
 * Sofle RGB ZMK keymap
 * Converted from QMK keymap.c
 *
 * Layout:
 *   Layer 0 (DVORAK) : メインレイヤー（QMK layer 0）
 *   Layer 1 (LOWER)  : Fn / 記号 / テンキー（QMK layer 2）
 *   Layer 2 (RAISE)  : マウス / 矢印（QMK layer 3）
 *
 * 変換メモ:
 *   KC_INT4/5      → INTERNATIONAL_4 / INTERNATIONAL_5
 *   QK_BOOTLOADER  → &bootloader
 *   KC_MPLY        → &kp C_PP
 *   KC_MEDIA_SELECT→ &kp C_MENU
 *   NK_ON          → &trans（ZMKはNKROがデフォルト）
 *   MS_ACL0/1/2    → &trans（ZMK未対応）
 *   MS_BTN*        → &mkp MB*
 *   MS_UP/DN/LT/RT → &mmv MOVE_UP/DOWN/LEFT/RIGHT
 *   MS_WHL*        → &msc SCRL_UP/DOWN/LEFT/RIGHT
 *
 * エンコーダー:
 *   左Layer0  : 時計回り=MB4 / 反時計=MB5
 *   左その他  : 時計回り=SCRL_RIGHT / 反時計=SCRL_LEFT
 *   右Layer0  : 時計回り=SCRL_UP / 反時計=SCRL_DOWN
 *   右その他  : 時計回り=PG_UP / 反時計=PG_DN
 *   ※ ZMKのsensor-bindingsはレイヤーごとに指定できないため
 *     Layer0の動作に統一しています（要件に合わせて変更可）
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* ============================================================== */
        /* Layer 0: DVORAK                                                 */
        /* ============================================================== */
        default_layer {
            label = "DVORAK";
            bindings = <
                &kp ESC        &kp N1     &kp N2    &kp N3    &kp N4    &kp N5                                        &kp N6    &kp N7    &kp N8     &kp N9    &kp N0    &kp GRAVE
                &kp TAB        &kp Q      &kp O     &kp U     &kp COMMA &kp DOT                                       &kp C     &kp W     &kp R      &kp J     &kp F     &kp SQT
                &lt 1 BSPC     &kp X      &kp I     &kp E     &kp A     &kp MINUS                                     &kp K     &kp T     &kp N      &kp S     &kp P     &kp ENTER
                &kp LSHFT      &kp H      &kp L     &kp Y     &kp V     &kp SLASH  &kp C_PP           &kp C_PP        &kp G     &kp D     &kp M      &kp Z     &kp B     &kp RSHFT
                                          &kp LCTRL &kp LALT  &kp LGUI  &kp SPACE  &lt 1 INTERNATIONAL_5  &lt 2 INTERNATIONAL_4  &kp BSPC  &kp RCTRL  &kp RALT  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_AC_NEXT C_AC_PREV &inc_dec_msc SCRL_UP SCRL_DOWN>;
        };

        /* ============================================================== */
        /* Layer 1: LOWER — Fn / 記号 / テンキー                          */
        /* ============================================================== */
        lower_layer {
            label = "LOWER";
            bindings = <
                &trans         &kp F1     &kp F2    &kp F3    &kp F4    &kp F5                                        &kp F6    &kp F7    &kp F8     &kp F9    &kp F10   &kp F11
                &kp GRAVE      &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT                                     &kp DEL   &kp KP_N7 &kp KP_N8  &kp KP_N9 &kp EQUAL &kp F12
                &trans         &kp LBKT   &kp RBKT  &kp LPAR  &kp RPAR  &kp LBRC                                      &kp RBRC  &kp KP_N4 &kp KP_N5  &kp KP_N6 &kp SEMI  &kp PIPE
                &kp LSHFT      &kp CARET  &kp AMPS  &kp STAR  &kp PLUS  &kp QMARK  &kp C_MENU         &bootloader     &kp KP_N0 &kp KP_N1 &kp KP_N2  &kp KP_N3 &kp BSLH  &kp RSHFT
                                          &trans    &trans    &trans    &trans     &trans                 &trans        &trans    &trans    &trans     &kp KP_NUM
            >;

            sensor-bindings = <&inc_dec_msc SCRL_RIGHT SCRL_LEFT &inc_dec_kp PG_UP PG_DN>;
        };

        /* ============================================================== */
        /* Layer 2: RAISE — マウス / ナビゲーション                        */
        /* ============================================================== */
        raise_layer {
            label = "RAISE";
            bindings = <
                &trans         &trans     &trans    &trans    &trans    &trans                                        &trans         &trans         &trans          &trans          &trans    &trans
                &kp ESC        &trans     &kp LEFT  &kp UP    &trans    &trans                                        &msc SCRL_UP   &mkp MB1       &mmv MOVE_UP    &mkp MB2        &mkp MB5  &trans
                &kp TAB        &trans     &trans    &trans    &kp RIGHT &trans                                        &msc SCRL_DOWN &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_RIGHT &mkp MB4  &trans
                &kp LSHFT      &trans     &trans    &trans    &trans    &kp DOWN   &bootloader        &bootloader     &trans         &msc SCRL_LEFT &mkp MB3        &msc SCRL_RIGHT &trans    &trans
                                          &kp LCTRL &kp LALT  &kp LGUI  &kp SPACE  &trans               &trans        &trans         &trans         &trans          &trans
            >;

            sensor-bindings = <&inc_dec_msc SCRL_RIGHT SCRL_LEFT &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
